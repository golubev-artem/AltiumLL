Procedure CreateGnssFootprints;
Begin
    Lib := PCBServer.GetCurrentPCBLibrary;
    If Lib = Nil Then
    Begin
        ShowMessage('Open SOMs.PcbLib and make it the active document, then run again.');
        Exit;
    End;
    OX := Lib.Board.XOrigin;
    OY := Lib.Board.YOrigin;
    MadeFP := 0; SkipFP := 0;
    FP_UBLOX_NEO_LCC24_12p2x16;
    FP_UNICORE_LCC28_17x22p4;
    FP_UNICORE_LCC28_17x22p4_EP35;
    FP_SEPTENTRIO_MOSAIC_LGA239_31x31;
    Lib.Board.ViewManager_FullUpdate;
    ShowMessage('Footprints created: ' + IntToStr(MadeFP) + ', skipped (already exist): ' + IntToStr(SkipFP) + '. Save SOMs.PcbLib.');
End;

{ ================= SCH helpers ================= }
Function SymExists(Name : String) : Boolean;
Var It : ISch_Iterator; C : ISch_Component;
Begin
    Result := False;
    It := SLib.SchLibIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eSchComponent));
    C := It.FirstSchObject;
    While C <> Nil Do
    Begin
        If C.LibReference = Name Then Result := True;
        C := It.NextSchObject;
    End;
    SLib.SchIterator_Destroy(It);
End;

Procedure AddObj(Obj : ISch_GraphicalObject);
Begin
    Obj.OwnerPartId := Comp.CurrentPartID;
    Obj.OwnerPartDisplayMode := Comp.DisplayMode;
    Comp.AddSchObject(Obj);
End;

{ X, Y in mils = body-side end of the pin; Dir 0 = pin goes right, 2 = left, 3 = down }
Procedure GPin(Des, Name : String; X, Y, Dir : Integer; Kind : TPinElectrical);
Var P : ISch_Pin;
Begin
    P := SchServer.SchObjectFactory(ePin, eCreate_Default);
    P.Designator := Des;
    P.Name := Name;
    P.Location := Point(MilsToCoord(X), MilsToCoord(Y));
    If Dir = 0 Then P.Orientation := eRotate0
    Else If Dir = 2 Then P.Orientation := eRotate180
    Else P.Orientation := eRotate270;
    P.PinLength := MilsToCoord(200);
    P.Electrical := Kind;
    AddObj(P);
End;

Procedure GParam(N, V : String);
Var P : ISch_Parameter;
Begin
    P := SchServer.SchObjectFactory(eParameter, eCreate_Default);
    P.Name := N;  P.Text := V;  P.IsHidden := True;
    AddObj(P);
End;

Function BeginSym(Name, Descr, FPName : String) : Boolean;
Var Impl : ISch_Implementation;
Begin
    Result := False;
    If SymExists(Name) Then Begin SkipSym := SkipSym + 1; Exit; End;
    Comp := SchServer.SchObjectFactory(eSchComponent, eCreate_Default);
    Comp.CurrentPartID := 1;
    Comp.DisplayMode := 0;
    Comp.LibReference := Name;
    Comp.ComponentDescription := Descr;
    Comp.Designator.Text := 'DD?';
    Comp.Comment.Text := Name;
    SLib.AddSchComponent(Comp);
    Impl := Comp.AddSchImplementation;
    Impl.ClearAllDatafileLinks;
    Impl.Description := 'Footprint';
    Impl.ModelName := FPName;
    Impl.ModelType := 'PCBLIB';
    Impl.AddDataFileLink(FPName, 'SOMs.PcbLib', 'PCBLIB');
    Impl.IsCurrent := True;
    Result := True;
End;

Procedure GBody(W, H : Integer);
Var R : ISch_Rectangle;
Begin
    R := SchServer.SchObjectFactory(eRectangle, eCreate_Default);
    R.Location := Point(0, MilsToCoord(-H));
    R.Corner   := Point(MilsToCoord(W), 0);
    R.LineWidth := eSmall;
    R.IsSolid := True;
    R.Color := $000080;
    R.AreaColor := $B0FFFF;
    AddObj(R);
End;

Procedure EndSym;
Begin
    SchServer.RobotManager.SendMessage(Nil, c_BroadCast, SCHM_PrimitiveRegistration, Comp.I_ObjectAddress);
    SLib.CurrentSchComponent := Comp;
    MadeSym := MadeSym + 1;
End;

