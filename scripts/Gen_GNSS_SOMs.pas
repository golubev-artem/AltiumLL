{ ------------------------------------------------------------------
  Gen_GNSS_SOMs.pas  -  GNSS modules for the TENSH.468157 family
  Altium Designer 26, DelphiScript. ASCII only.

  Footprints (run with SOMs.PcbLib open and active):
     DXP > Run Script > Gen_GNSS_SOMs.pas > CreateGnssFootprints
       UBLOX_NEO_LCC24_12.2x16          NEO-F10T (and NEO-M9N)
       UNICORE_LCC28_17x22.4            UM220-IV L
       UNICORE_LCC28_17x22.4_EP35       UT986
       SEPTENTRIO_MOSAIC_LGA239_31x31   mosaic-T
  Symbols (run with the target SchLib open and active, e.g. a new SOMs.SchLib):
     DXP > Run Script > Gen_GNSS_SOMs.pas > CreateGnssSymbols
       NEO-F10T, UM220-IV_L, UT986, mosaic-T  (footprint link -> SOMs.PcbLib)

  Existing items with the same name are skipped, so the script can be re-run.
  Layers: pads Top, silkscreen Top Overlay, courtyard Mechanical 15.
  Generated 2026-11-11 for SHIWA NETWORK (TENSH.468157.05-.12).
  ------------------------------------------------------------------ }

Var
    Lib  : IPCB_Library;
    FP   : IPCB_LibComponent;
    OX, OY : Integer;
    MadeFP, SkipFP : Integer;
    SLib : ISch_Lib;
    Comp : ISch_Component;
    MadeSym, SkipSym : Integer;

{ ================= PCB helpers ================= }
Procedure RegObj(Obj : IPCB_Primitive);
Begin
    FP.AddPCBObject(Obj);
    PCBServer.SendMessageToRobots(FP.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, Obj.I_ObjectAddress);
End;

Procedure GPad(Name : String; X, Y, W, H : Double; IsRound : Boolean; Mask : Double);
Var P : IPCB_Pad; C : TPadCache;
Begin
    P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
    P.Mode     := ePadMode_Simple;
    P.X        := OX + MMsToCoord(X);
    P.Y        := OY + MMsToCoord(Y);
    P.TopXSize := MMsToCoord(W);
    P.TopYSize := MMsToCoord(H);
    If IsRound Then P.TopShape := eRounded Else P.TopShape := eRectangular;
    P.HoleSize := 0;
    P.Layer    := eTopLayer;
    P.Name     := Name;
    If Mask > 0 Then
    Begin
        C := P.GetState_Cache;
        C.SolderMaskExpansion      := MMsToCoord(Mask);
        C.SolderMaskExpansionValid := eCacheManual;
        P.SetState_Cache := C;
    End;
    RegObj(P);
End;

Procedure GLine(X1, Y1, X2, Y2, W : Double; Layer : TLayer);
Var T : IPCB_Track;
Begin
    T := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
    T.X1 := OX + MMsToCoord(X1);  T.Y1 := OY + MMsToCoord(Y1);
    T.X2 := OX + MMsToCoord(X2);  T.Y2 := OY + MMsToCoord(Y2);
    T.Width := MMsToCoord(W);
    T.Layer := Layer;
    RegObj(T);
End;

Procedure GDot(X, Y, R : Double);
Var A : IPCB_Arc;
Begin
    A := PCBServer.PCBObjectFactory(eArcObject, eNoDimension, eCreate_Default);
    A.XCenter := OX + MMsToCoord(X);  A.YCenter := OY + MMsToCoord(Y);
    A.Radius := MMsToCoord(R);  A.LineWidth := MMsToCoord(R);
    A.StartAngle := 0;  A.EndAngle := 360;
    A.Layer := eTopOverlay;
    RegObj(A);
End;

Procedure GBox(HX, HY, W : Double; Layer : TLayer);
Begin
    GLine(-HX, -HY,  HX, -HY, W, Layer);
    GLine( HX, -HY,  HX,  HY, W, Layer);
    GLine( HX,  HY, -HX,  HY, W, Layer);
    GLine(-HX,  HY, -HX, -HY, W, Layer);
End;

Function BeginFP(Name, Descr : String; Height : Double) : Boolean;
Begin
    Result := False;
    If Lib.GetComponentByName(Name) <> Nil Then
    Begin
        SkipFP := SkipFP + 1;
        Exit;
    End;
    FP := PCBServer.CreatePCBLibComp;
    FP.Name := Name;
    FP.Description := Descr;
    FP.Height := MMsToCoord(Height);
    Lib.RegisterComponent(FP);
    PCBServer.PreProcess;
    Result := True;
End;

Procedure EndFP;
Begin
    PCBServer.PostProcess;
    Lib.CurrentComponent := FP;
    MadeFP := MadeFP + 1;
End;

