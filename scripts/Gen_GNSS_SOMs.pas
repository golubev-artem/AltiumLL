Procedure CreateGnssSymbols;
Var Doc : ISch_Document;
Begin
    If SchServer = Nil Then Exit;
    Doc := SchServer.GetCurrentSchDocument;
    If (Doc = Nil) Or (Doc.ObjectID <> eSchLib) Then
    Begin
        ShowMessage('Open the target SchLib (e.g. SOMs.SchLib) and make it active, then run again.');
        Exit;
    End;
    SLib := Doc;
    MadeSym := 0; SkipSym := 0;
    SchServer.ProcessControl.PreProcess(SLib, '');
    SYM_NEO_F10T;
    SYM_UM220_IV_L;
    SYM_UT986;
    SYM_mosaic_T;
    SchServer.ProcessControl.PostProcess(SLib, '');
    SLib.GraphicallyInvalidate;
    ShowMessage('Symbols created: ' + IntToStr(MadeSym) + ', skipped (already exist): ' + IntToStr(SkipSym) + '. Save the library. GND / VDD pins are stacked on purpose.');
End;
